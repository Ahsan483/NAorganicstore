# ───────── Site ─────────
NEXT_PUBLIC_SITE_URL=https://www.naorganicstore.com
NEXT_PUBLIC_WHATSAPP_NUMBER=923489374748
NEXT_PUBLIC_CONTACT_EMAIL=hakeemaziz8320@gmail.com
# Optional: Google Search Console HTML-tag verification token
NEXT_PUBLIC_GSC_VERIFICATION=

# ───────── Database (Turso / libSQL) ─────────
# Create free DB:  turso db create na-organic && turso db show na-organic --url && turso db tokens create na-organic
DATABASE_URL=libsql://your-db-name-your-org.turso.io
DATABASE_AUTH_TOKEN=

# ───────── Admin login ─────────
ADMIN_USERNAME=admin
# Generate with:  npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=
# Random 32+ chars:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ───────── Email (SMTP) ─────────
# Gmail: enable 2-step verification, then create an "App password" at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourstore@gmail.com
SMTP_PASS=
# Where new-order / chat / contact alerts go
ADMIN_EMAIL=hakeemaziz8320@gmail.com

# ───────── WhatsApp alerts ─────────
# Number that receives new-order alerts (country code, digits only)
ADMIN_WHATSAPP=923489374748
# Pick ONE provider:  callmebot | cloudapi | twilio
WHATSAPP_PROVIDER=callmebot

# callmebot (free, alerts to YOUR number only — cannot message customers)
#   1) Save +34 644 52 74 88 as a contact, 2) send it:  I allow callmebot to send me messages
#   3) it replies with your API key
CALLMEBOT_APIKEY=

# cloudapi (Meta WhatsApp Business Cloud API — can also message customers)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Messages to people who haven't messaged you in 24h need approved templates. Set true once approved.
WHATSAPP_USE_TEMPLATES=false
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_ADMIN=new_order_admin
WHATSAPP_TEMPLATE_CUSTOMER=order_confirmation
WHATSAPP_TEMPLATE_STATUS=order_status
WHATSAPP_TEMPLATE_CHAT=new_chat_admin

# twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# ───────── Shipping (PKR) ─────────
SHIPPING_FLAT_RATE=250
SHIPPING_FREE_OVER=3000
